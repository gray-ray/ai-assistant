<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.grayray</groupId>
        <artifactId>ai-assistant</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>ai-assistant-server</artifactId>
    <name>ai-assistant-server</name>
    <dependencies>
        <dependency>
            <groupId>org.grayray</groupId>
            <artifactId>ai-assistant-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.grayray</groupId>
            <artifactId>ai-assistant-rag-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.grayray</groupId>
            <artifactId>ai-assistant-user</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.grayray</groupId>
            <artifactId>ai-assistant-document</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.grayray</groupId>
            <artifactId>ai-assistant-chat</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
